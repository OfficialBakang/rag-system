
# ============================================================
# RAG System - Environment Configuration
# ============================================================
# Copy this file to .env and supply your own API credentials.
# Never commit your actual .env file or real API keys.
# ============================================================

# ------------------------------------------------------------
# API startup mode (true enables local storage and HTTP probes only)
RAG_SMOKE_TEST_MODE=false

# Required API credentials
# ------------------------------------------------------------

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Embedding configuration
# ------------------------------------------------------------

EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------
# Document chunking
# ------------------------------------------------------------

CHUNK_SIZE=400
CHUNK_OVERLAP=80

# ------------------------------------------------------------
# ChromaDB vector storage
# ------------------------------------------------------------

CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=rag_documents

# ------------------------------------------------------------
# Retrieval configuration
# ------------------------------------------------------------

RETRIEVAL_TOP_K=6
RERANK_TOP_N=3

# ------------------------------------------------------------
# LLM generation
# ------------------------------------------------------------

# Use a Claude model available to your Anthropic account.
LLM_MODEL=claude-sonnet-4-5
MAX_TOKENS=1024

# ------------------------------------------------------------
# LLM-as-judge evaluation
# ------------------------------------------------------------

EVAL_MODEL=claude-sonnet-4-5
EVAL_LOG_PATH=./data/evals.jsonl

# ------------------------------------------------------------
# OpenTelemetry configuration
# ------------------------------------------------------------

# Enable only when an OTLP collector is available.
# Local tracing and console output remain available.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rag-system
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ------------------------------------------------------------
# Local trace persistence
# ------------------------------------------------------------

TRACE_LOG_PATH=./data/traces.jsonl


# Required in both modes. Generate each independently with secrets.token_hex(32).
RAG_READER_API_KEY=
RAG_EDITOR_API_KEY=
RAG_ADMIN_API_KEY=
RAG_PUBLIC_DOCS=true
RAG_CORS_ORIGINS=

# Process-local one-minute quotas and concurrent AI request slots.
RAG_LIMIT_GENERAL=60
RAG_LIMIT_QUERY=10
RAG_LIMIT_INGEST=5
RAG_LIMIT_EVALUATE=5
RAG_LIMIT_ANONYMOUS=120
RAG_LIMIT_CONCURRENT=3

# Bytes for wire/upload limits, characters for decoded text.
RAG_LIMIT_QUERY_CHARS=2000
RAG_LIMIT_TEXT_CHARS=100000
RAG_LIMIT_TOP_K=20
RAG_LIMIT_UPLOAD_BYTES=10485760
RAG_LIMIT_BODY_BYTES=12582912
RAG_LIMIT_PDF_PAGES=100
RAG_LIMIT_EXTRACTED_CHARS=200000
RAG_LIMIT_CHUNKS=256
RAG_LIMIT_EMBEDDING_BATCHES=3
RAG_LIMIT_CONTEXT_CHARS=32000
